APP_NAME="Studio Kassandra"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salon_manager
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DRIVER=public

# SMS (driver pattern — see App\Services\Sms). Which gateway each salon uses and its
# credentials are configured per salon in Settings → SMS Reminders, not here — this
# is only the global label shown in the audit log at storage/logs/sms.log.
SMS_SENDER_ID="${APP_NAME}"

# How many hours before an appointment its reminder goes out.
REMINDER_HOURS_BEFORE=24

TELESCOPE_ENABLED=true

# Multi-tenancy
APP_MODE=single
# Uncomment the line below for multi-tenant setup
# APP_MODE=multi

# Redis configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue settings
QUEUE_DRIVER=sync

# Localization
LOCALE=en
FALLBACK_LOCALE=en

# Other settings
DARK_MODE=false
